# Database: the dedicated role created by stuff/db/scripts/create-admin-role.sql
# (SELECT on what the admin shows; UPDATE on beta applications; INSERT on audit_logs — nothing else).
DATABASE_URL=postgresql://kleos_admin:password@host/dbname?sslmode=require

# Single admin, TOTP login. Generate with `npm run totp:init`: it prints the secret (put it here) and a
# link/QR URI for the authenticator app.
ADMIN_TOTP_SECRET=
# Signs the session cookie. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# kleoshq-notifications (approval / decline e-mails)
NOTIFICATIONS_SERVICE_URL=
NOTIFICATIONS_INTERNAL_SECRET=

# Public site: the links in the mails sent from here (sign in / sign up).
PUBLIC_SITE_URL=https://www.sitewitness.app

# Beta places: shown as "X / N" on the beta page.
BETA_SLOTS=10
